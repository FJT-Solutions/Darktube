// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Channel {
  id              String   @id // YouTube Channel ID
  name            String
  handle          String
  avatarUrl       String?
  bannerUrl       String?
  subscribers     BigInt?
  totalViews      BigInt?
  videoCount      Int?
  description     String?
  joinedDate      DateTime?
  country         String?
  url             String?
  verified        Boolean  @default(false)
  topicCategories String?  // Stored as JSON string or comma-separated
  darkType        String?
  notes           String?
  tags            String?  // Stored as JSON string or comma-separated
  trackedAt       DateTime @default(now())
  
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  
  videos          Video[]
  metricsHistory  ChannelMetricsHistory[]
}

model Video {
  id           String    @id // YouTube Video ID
  channelId    String
  channel      Channel   @relation(fields: [channelId], references: [id])
  title        String
  thumbnailUrl String?
  views        BigInt?
  likes        BigInt?
  comments     BigInt?
  duration     String?
  publishedAt  DateTime?
  type         String?   // 'video', 'shorts', or 'live'
  transcript   String?
  aiAnalysis   String?   // Stored as JSON string
  
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
}

model ChannelMetricsHistory {
  id                    String   @id @default(uuid())
  channelId             String
  channel               Channel  @relation(fields: [channelId], references: [id])
  subscribers           BigInt?
  totalViews            BigInt?
  avgViewsPerVideo      Float?
  estimatedMonthlyViews BigInt?
  estimatedRevenue      Float?
  darkScore             Float?
  createdAt             DateTime @default(now())
}

// --- NextAuth Models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  settings      Settings?
  channels      Channel[]
  videos        Video[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Settings {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  geminiApiKey  String?
  youtubeScope  Boolean @default(false)
  updatedAt     DateTime @updatedAt
}
